<?xml version="1.0" encoding="utf-8"?>
<!--
  [ES] Pantalla principal rediseñada (vertical): encabezado, menú y la tarjeta
  de detalles debajo. Se conservan todos los id que usa MainActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/pes_page"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingTop="20.0dip"
    android:paddingStart="20.0dip"
    android:paddingEnd="20.0dip">

    <!-- Encabezado -->
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:text="@string/titulo_app" android:textSize="24.0sp" android:textStyle="bold"
            android:textColor="@color/pes_text" android:fontFamily="sans-serif" android:letterSpacing="-0.01"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/wordmark" />
        <TextView android:text="@string/insignia_es" android:textSize="11.0sp" android:textStyle="bold"
            android:textColor="@color/pes_gold" android:background="@drawable/bg_badge" android:fontFamily="sans-serif-medium"
            android:paddingStart="7.0dip" android:paddingEnd="7.0dip" android:paddingTop="2.0dip" android:paddingBottom="2.0dip"
            android:layout_marginStart="10.0dip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@id/version_tag" android:textSize="11.0sp" android:textColor="@color/pes_muted"
        android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"
        android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dip" />

    <!-- Menú -->
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="0.0dip"
        android:layout_weight="1.0" android:layout_marginTop="16.0dip">
        <Button android:id="@id/play" android:text="@string/play" android:textColor="@color/pes_gold"
            android:textStyle="bold" android:autoSizeMaxTextSize="20.0sp" style="@style/MenuEntry" />
        <Button android:id="@id/select_folder" android:text="@string/entry_select_folder" style="@style/MenuEntry" />
        <Button android:id="@id/install" android:text="@string/entry_install" style="@style/MenuEntry" />
        <Button android:id="@id/settings" android:text="@string/entry_settings" style="@style/MenuEntry" />
        <Button android:id="@id/driver" android:text="@string/graphics_driver" style="@style/MenuEntry" />
        <Button android:id="@id/log" android:text="@string/view_log" style="@style/MenuEntry" />
        <Button android:id="@id/entry_updates" android:text="@string/check_updates" style="@style/MenuEntry" />
        <Button android:id="@id/entry_quit" android:text="@string/quit_launcher" style="@style/MenuEntry" />
        <androidx.appcompat.widget.SwitchCompat android:id="@id/direct_launch_switch" android:text="@string/direct_launch"
            android:textSize="12.0sp" android:textColor="@color/pes_muted" android:fontFamily="sans-serif"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip" android:layout_marginStart="14.0dip" />
    </LinearLayout>

    <!-- Tarjeta de detalles -->
    <LinearLayout android:orientation="vertical" android:background="@drawable/bg_panel"
        android:layout_width="fill_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip" android:layout_marginBottom="12.0dip" android:padding="18.0dip">
        <TextView android:id="@id/detail_title" android:text="@string/detail_default_title"
            android:textSize="17.0sp" android:textStyle="bold" android:textColor="@color/pes_text"
            android:fontFamily="sans-serif" android:textAllCaps="false"
            android:layout_width="fill_parent" android:layout_height="wrap_content" />
        <TextView android:id="@id/detail_text" android:text="@string/detail_default_text"
            android:textSize="13.0sp" android:textColor="@color/pes_muted" android:fontFamily="sans-serif"
            android:lineSpacingExtra="3.0dip" android:maxLines="6" android:ellipsize="end"
            android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="6.0dip" />
        <TextView android:id="@id/status" android:textSize="13.0sp" android:textColor="@color/pes_blue"
            android:fontFamily="sans-serif-medium" android:background="@drawable/bg_status"
            android:lineSpacingExtra="3.0dip" android:maxLines="6" android:ellipsize="end" android:padding="12.0dip"
            android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="14.0dip" />
    </LinearLayout>

    <!-- Pie de página -->
    <TextView android:id="@id/footer" android:textSize="11.0sp" android:textColor="@color/pes_muted"
        android:background="@drawable/bg_ticker" android:fontFamily="sans-serif" android:gravity="center_vertical"
        android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever" android:focusable="false"
        android:layout_width="fill_parent" android:layout_height="28.0dip" />
</LinearLayout>
